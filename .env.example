# ==============================================================================
# Face Recognition & Identity Verification Environment Configuration
# ==============================================================================

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Face recognition settings
FACE_MODEL=buffalo_l
FACE_SIMILARITY_THRESHOLD=0.50

# OCR settings
OCR_LANGUAGE=en
OCR_USE_ANGLE_CLS=true

# Camera settings
CAMERA_INDEX=0
MAX_CAMERAS_TO_CHECK=5

# Session settings (TTL in seconds: 900 = 15 minutes)
SESSION_TTL_SECONDS=900
